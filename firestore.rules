rules_version = '2';

// Modelo de acceso de Allpa SOE:
//  - Cada usuario pertenece como máximo a una empresa (users/{uid}.companyId).
//  - Los datos de una empresa (bloques, páginas, secciones, checklist, notas)
//    solo son legibles/editables por sus miembros (companies/{id}/members/{uid}).
//  - El super administrador puede leer los metadatos de nivel raíz de
//    cualquier empresa (para el panel global), pero NO las subcolecciones
//    internas, salvo que esa empresa le haya otorgado acceso explícito
//    (companies/{id}.superadminAccessGrant.granted == true).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperadmin() {
      return isSignedIn() && myProfile().role == 'superadmin';
    }

    function isCompanyMember(companyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId) &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function hasSuperadminGrant(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data.superadminAccessGrant.granted == true;
    }

    function canReadCompanyData(companyId) {
      return isCompanyMember(companyId) || (isSuperadmin() && hasSuperadminGrant(companyId));
    }

    // ── Usuarios ──
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperadmin());
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Empresas ──
    match /companies/{companyId} {
      // Metadatos de nivel raíz: miembros siempre, superadmin siempre (panel global,
      // sin necesidad de grant — solo ve nombre/plan/conteo, no el contenido interno).
      allow read: if isCompanyMember(companyId) || isSuperadmin();
      allow create: if isSignedIn();
      // El superadmin NUNCA puede escribir superadminAccessGrant (el otorgamiento es
      // decisión exclusiva del admin de la empresa) — solo puede dejar una solicitud.
      allow update: if isCompanyAdmin(companyId) ||
        (isSuperadmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['superadminAccessRequest']));

      match /members/{memberId} {
        allow read: if canReadCompanyData(companyId);
        // Bootstrap: el dueño de una empresa recién creada todavía no tiene su
        // propio doc de member, así que isCompanyAdmin() aún no puede ser true.
        // Se le permite crear (solo) su propio doc de member como admin.
        allow create: if isCompanyAdmin(companyId) ||
          (isSignedIn() && request.auth.uid == memberId &&
           get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid);
        allow update, delete: if isCompanyAdmin(companyId);
      }

      match /blocks/{blockId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyAdmin(companyId);

        match /pages/{pageId} {
          allow read: if canReadCompanyData(companyId);
          allow write: if isCompanyAdmin(companyId);
        }
      }

      // ── Módulo Contenido ──
      // Mismas reglas para todas sus colecciones: las lee cualquiera con
      // acceso a la empresa y las edita cualquier miembro.
      match /pillars/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /episodes/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /derivedContent/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /mediaAssets/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /academyClasses/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /downloadables/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }

      // ── Módulo CRM ──
      // Mismo criterio de aislamiento por empresa que el módulo Contenido.
      // El prefijo `crm` evita confundir estas empresas (las del CRM) con la
      // colección raíz `companies`, que son las inquilinas de la plataforma.
      match /crmContacts/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmAccounts/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmFamilies/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmNodes/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmRelationships/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmDeals/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmActivities/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmProducts/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmAgreements/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmTags/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmSegments/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }
      match /crmAutomations/{docId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }

      // Personalización de cada página: características visibles y bloques
      // agregados por el administrador.
      match /pageConfig/{pageKey} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /pages/{pageId} {
        allow read: if canReadCompanyData(companyId);
        allow write: if isCompanyMember(companyId);

        match /sections/{sectionId} {
          allow read: if canReadCompanyData(companyId);
          allow write: if isCompanyMember(companyId);

          match /checklistItems/{itemId} {
            allow read: if canReadCompanyData(companyId);
            allow write: if isCompanyMember(companyId);

            match /notes/{noteId} {
              allow read: if canReadCompanyData(companyId);
              allow create: if isCompanyMember(companyId) && request.resource.data.authorUid == request.auth.uid;
              allow update, delete: if isCompanyMember(companyId) && resource.data.authorUid == request.auth.uid;
            }
          }
        }
      }
    }

    // ── Invitaciones ── (el documento se identifica por el token, que actúa
    // como capacidad de acceso: solo quien tiene el enlace puede leerlo)
    match /invitations/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isCompanyAdmin(request.resource.data.companyId);
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isCompanyAdmin(resource.data.companyId);
    }
  }
}
